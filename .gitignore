# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.uv/

# Models & generated binaries
models/**/*.safetensors
models/**/*.ckpt
models/**/*.pth
models/**/*.bin
models/**/*.gguf
models/**/*.onnx
models/taggers/*.csv
!models/**/.gitkeep

# ComfyUI
vendor/ComfyUI/
comfyui.log
.comfyui.pid

# Project outputs (keep manifests, drop heavy images by default)
projects/*/panels/*.png
projects/*/panels/*.webp
projects/*/characters/**/*.png
projects/*/characters/**/*.webp


# OS / editor
.DS_Store
*.swp
.env

# Customised GIMP fork: its own git repo (github.com/imattau/imanganation-gimp)
imanganation-gimp/

# More generated images: datasets, retake/backup folders (panels_*, characters_*)
projects/*/datasets/**/*.png
projects/*/panels*/*.png
projects/*/characters*/**/*.png

# Scratch exports (e.g. GIMP reference crops before registration)
projects/*/tmp/

# Project containers: generated takes and masks (the manifest, script and pages are tracked)
projects/*.imanga/takes/
projects/*.imanga/masks/

# Engine render cache for inline (project-container) renders; the plug-in copies takes out
outputs/

# Engine log when GIMP starts it (the workspace extension)
engine.log

# Flatpak packaging: builder state, local repo and the bundles it produces
packaging/flatpak/.build/
.flatpak-builder/
dist/

# Engine caches (e.g. LLM panel staging, render/staging.py)
cache/

# Location reference images (the manifest locations.json is tracked)
projects/*/locations/*.png
